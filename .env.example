# CYBERTRACE configuration.
# Copy to .env and replace every CHANGE_ME value before running outside development.
# The application refuses to start in production if any secret is left at its default.

CYBERTRACE_ENV=development
CYBERTRACE_DEBUG=true

# --- Database ---
# Matches ops/docker-compose.yml (host port 5433 to avoid clashing with a native Postgres).
CYBERTRACE_DATABASE_URL=postgresql+psycopg://cybertrace:cybertrace_dev_password@localhost:5433/cybertrace

# --- Cryptographic material ---
# Generate each with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
CYBERTRACE_SECRET_KEY=dev-insecure-secret-key-change-me
# Master key-encryption-key (KEK) wrapping every per-object evidence data key.
# Generate with: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
CYBERTRACE_MASTER_KEY=Y3liZXJ0cmFjZS1kZXZlbG9wbWVudC1rZWstMzJieXQ=

# --- Tokens ---
CYBERTRACE_ACCESS_TOKEN_TTL_SECONDS=900
CYBERTRACE_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Storage ---
# Evidence objects are written here AES-256-GCM encrypted and content-addressed.
CYBERTRACE_STORAGE_ROOT=./var/storage
CYBERTRACE_MAX_UPLOAD_BYTES=2147483648

# --- Web ---
CYBERTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CYBERTRACE_COOKIE_SECURE=false

# --- Background worker ---
CYBERTRACE_WORKER_ENABLED=true
CYBERTRACE_WORKER_CONCURRENCY=2

# --- Optional LLM enrichment (disabled by default) ---
# When disabled, the deterministic engine supplies every insight.
CYBERTRACE_LLM_ENABLED=false
CYBERTRACE_LLM_API_KEY=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
